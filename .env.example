# Copy this file to .env and fill in your own values. Never commit .env.

# --- Flask ---
SECRET_KEY=replace-with-a-random-long-secret
DATABASE_URL=sqlite:///library.db

# --- Local admin account ---
# Only set these to seed a local password-based admin. Leave blank to skip.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Google OAuth ---
# Create a Google OAuth Web application client in Google Cloud Console.
# See GOOGLE_LOGIN_SETUP.md for detailed instructions.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google OAuth / Firebase Admin Emails ---
# Comma-separated list of Google emails that receive the 'admin' role.
# Students do NOT need to be listed here — they are looked up by email
# in the students table.
GOOGLE_ADMIN_EMAILS=your.admin.email@gmail.com

# --- Firebase & Firestore Configuration ---
USE_FIREBASE=true
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=1:your-messaging-sender-id:web:your-app-id

# --- Session ---
# Keep false for localhost HTTP development. Set true when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false

# --- Debug ---
# FLASK_DEBUG=false
